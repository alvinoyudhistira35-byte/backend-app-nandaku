# ====== CONTOH PENGATURAN (salin jadi .env atau isi di panel Environment hosting) ======

# Port server
PORT=5000

# ====== PALING PENTING: PENYIMPANAN DATA PERMANEN (GRATIS) ======
# Kebanyakan hosting GRATIS (mis. Render free) TIDAK menyediakan persistent disk gratis,
# jadi cara paling andal & gratis adalah menyimpan data di MongoDB Atlas (tier M0, gratis
# selamanya, tanpa kartu kredit). Cara membuatnya ada di backend/README.md.
# Setelah punya connection string dari Atlas, isi di sini:
# Setelah punya connection string dari Atlas, GANTI baris di bawah ini (hapus tanda # dan
# isi dengan connection string ASLI kamu, JANGAN dibiarkan seperti contoh):
# MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
# MONGODB_DB_NAME=nandaku

# ====== PENTING JUGA: FILE UPLOAD PERMANEN (AUDIO & GAMBAR, GRATIS) ======
# MONGODB_URI di atas HANYA menyimpan data (judul lagu, dst), BUKAN file audio/gambar itu
# sendiri. Tanpa ini, lagu tetap tercatat tapi filenya hilang saat server restart/redeploy
# -> gagal diputar (404). Buat akun Cloudinary (gratis, tanpa kartu kredit) di
# https://cloudinary.com/users/register/free, lalu salin "API Environment variable" dari
# dashboard (Settings -> API Keys). Cara lengkap ada di backend/README.md.
# GANTI baris di bawah ini dengan nilai ASLI dari dashboard kamu:
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# ====== OPSIONAL: PERSISTENT DISK (kalau hosting-nya berbayar & menyediakan disk) ======
# Kalau tidak diisi, cukup abaikan bagian ini -> MONGODB_URI + CLOUDINARY_URL di atas
# sudah cukup untuk semuanya (data maupun file upload), tanpa perlu disk sama sekali.
# Cukup salah satu cara:
#   STORAGE_DIR=/data
# atau lebih rinci:
#   DATA_DIR=/data/data
#   UPLOADS_DIR=/data/uploads
# STORAGE_DIR=/data

# ====== AKUN ADMIN ======
# WAJIB diganti di produksi. API key admin dibuat tetap supaya tidak pernah "tidak valid".
ADMIN_EMAIL=admin@nandaku.com
ADMIN_PASSWORD=ganti-password-ini
ADMIN_API_KEY=ganti-dengan-kunci-acak-yang-panjang

# ====== BATAS UPLOAD (MB) ======
MAX_AUDIO_MB=30
MAX_IMAGE_MB=5

# ====== OPSIONAL ======
# Set false kalau frontend di-hosting terpisah
SERVE_FRONTEND=true
GOOGLE_CLIENT_ID=
