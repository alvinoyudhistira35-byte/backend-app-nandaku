{
  "name": "nandaku-backend",
  "version": "1.0.0",
  "description": "Backend API aplikasi musik berbasis API key (auth, lagu, peliharaan virtual, typing test, pertemanan, story, chat, admin)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed-admin": "node seed-admin.js"
  },
  "dependencies": {
    "express": "^4.19.2",
    "cors": "^2.8.5",
    "uuid": "^9.0.1",
    "multer": "^1.4.5-lts.1",
    "mongodb": "^6.9.0",
    "cloudinary": "^2.5.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.0"
  },
  "nodemonConfig": {
    "ignore": [
      "data/*",
      "data/**/*",
      "uploads/*",
      "uploads/**/*",
      ".data/*",
      ".data/**/*",
      "**/data/**",
      "**/.data/**",
      "**/uploads/**"
    ]
  },
  "engines": {
    "node": ">=18"
  }
}